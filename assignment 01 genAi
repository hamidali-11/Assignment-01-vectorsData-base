## 9. Create or connect to a Pinecone index
This cell does not delete any existing index.

import time
INDEX_NAME = "banoqabil-fm"

if INDEX_NAME not in database.list_indexes().names():
    database.create_index(
        name=INDEX_NAME,
        dimension=EMBEDDING_DIM,
        metric="cosine",
        spec=ServerlessSpec(cloud="aws", region="us-east-1"),
    )
while not database.describe_index(INDEX_NAME).status["ready"]:
    time.sleep(1)
pinecone_index = database.Index(INDEX_NAME)
