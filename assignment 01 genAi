## 11. Prepare vector records for Pinecone
Each record contains an ID, normalized embedding vector, and sentence metadata.

def vector(batch):
    records = []
    for row in batch.to_dict("records"):
        records.append({
            "id": str(row["id"]),
            "values": row["embedding"],
            "metadata": {"sentence": row["sentence"]},
        })
    return records

vector(dataset)[:2]


## 12. Upload vectors (upsert)
Upsert updates records with matching IDs and adds missing records. This cell sends your dataset to Pinecone.

records = vector(dataset)
# Upload in batches, avoiding oversized requests.
for start in range(0, len(records), 100):
    pinecone_index.upsert(vectors=records[start:start + 100])
print("Uploaded vectors:", len(records))


