## 7. Local similarity search (NumPy)

def search(query, k=5):
    query_vector = np.array(get_embedding(query), dtype=np.float32)
    scores = embeddings @ query_vector  # normalized vectors -> cosine similarity
    top_idx = np.argsort(scores)[::-1][:k]
    return dataset.iloc[top_idx][["id", "sentence"]].assign(score=scores[top_idx]).reset_index(drop=True)

search("a man is working hard", 5)


